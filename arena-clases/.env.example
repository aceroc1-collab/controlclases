# Copia este archivo como .env.local para desarrollo.
# En Vercel se cargan en Settings -> Environment Variables.
# Si estan vacias, la app funciona solo con los datos del dispositivo.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Pega aqui la clave publica de tu proyecto. Sirve cualquiera de las dos:
# la publicable nueva (sb_publishable_...) o la anon de los proyectos viejos.
VITE_SUPABASE_KEY=sb_publishable_TU_CLAVE
